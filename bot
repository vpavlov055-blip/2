def convert_webp_to_jpg(input_path, output_path):
    try:
        print(f"Конвертация WEBP в JPG: {input_path}")
        from PIL import Image
        
        with Image.open(input_path) as img:
            if img.mode == 'RGBA':
                background = Image.new('RGB', img.size, (255, 255, 255))
                background.paste(img, mask=img.split()[3])
                img = background
            elif img.mode != 'RGB':
                img = img.convert('RGB')
            
            img.save(output_path, 'JPEG', quality=95)
        
        if os.path.exists(output_path):
            print(f"JPG создан, размер: {os.path.getsize(output_path)}")
            return True
        return False
    except Exception as e:
        print(f"Ошибка WEBP to JPG: {e}")
        return False

def convert_pdf_to_jpg(input_path, output_path):
    try:
        print(f"Конвертация PDF в JPG: {input_path}")
        import fitz  
        from PIL import Image
        import io
        
        doc = fitz.open(input_path)
        
        page = doc[0]
        
        pix = page.get_pixmap()
        img_data = pix.tobytes("png")
        
        img = Image.open(io.BytesIO(img_data))
        img.save(output_path, 'JPEG', quality=95)
        
        doc.close()
        
        if os.path.exists(output_path):
            print(f"JPG создан, размер: {os.path.getsize(output_path)}")
            return True
        return False
    except Exception as e:
        print(f"Ошибка PDF to JPG: {e}")
        return False

