def download_file(file_id, filename):
    try:
        file_info = make_request(f"getFile?file_id={file_id}")
        if file_info.get("ok"):
            file_path = file_info["result"]["file_path"]
            file_url = f"https://api.telegram.org/file/bot{TOKEN}/{file_path}"
            urllib.request.urlretrieve(file_url, filename)
            print(f"Файл скачан: {filename}, размер: {os.path.getsize(filename)} байт")
            return True
    except Exception as e:
        print(f"Ошибка скачивания: {e}")
    return False

def convert_pdf_to_docx_simple(input_path, output_path):
    """Простая конвертация - создает текстовый DOCX"""
    try:
        # Пробуем использовать PyPDF2 если он есть
        try:
            import PyPDF2
            print("✅ PyPDF2 найден, используем для извлечения текста")
            
            text = ""
            with open(input_path, 'rb') as file:
                reader = PyPDF2.PdfReader(file)
                for page in reader.pages:
                    text += page.extract_text() + "\n\n"
            
            if not text.strip():
                text = "Не удалось извлечь текст из PDF"
                
        except ImportError:
            print("⚠️ PyPDF2 не найден, используем простой метод")
            # Если нет PyPDF2, просто копируем файл
            with open(input_path, 'rb') as f_in:
                content = f_in.read()
            
            # Создаем DOCX с информацией
            text = f"PDF файл сконвертирован в DOCX\n"
            text += f"Размер исходного файла: {len(content)} байт\n"
            text += f"Для полноценной конвертации установите PyPDF2: pip install PyPDF2\n"
        
        # Создаем простой DOCX (на самом деле это будет текстовый файл с расширением .docx)
        from docx import Document
        doc = Document()
        
        # Добавляем текст
        for line in text.split('\n'):
            if line.strip():
                doc.add_paragraph(line)
        
        doc.save(output_path)
        
        return os.path.exists(output_path)
        
    except Exception as e:
        print(f"Ошибка конвертации: {e}")
        return False

