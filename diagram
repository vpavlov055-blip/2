    buttons = []
    
    if ext == '.txt':
        buttons.append([{"text": "TXT → PDF", "callback_data": "again_txt_pdf"}])
    elif ext == '.pdf':
        buttons.append([{"text": "PDF → DOCX", "callback_data": "again_pdf_docx"}])
    elif ext == '.docx':
        buttons.append([{"text": "DOCX → TXT", "callback_data": "again_docx_txt"}])
    elif ext in ('.jpg', '.jpeg'):
        buttons.append([{"text": "JPG → PNG", "callback_data": "again_jpg_png"}])
    elif ext == '.png':
        buttons.append([{"text": "PNG → JPG", "callback_data": "again_png_jpg"}])
    elif ext in ('.heic', '.heif'):
        buttons.extend([
            [{"text": "HEIC → JPG", "callback_data": "again_heic_jpg"}],
            [{"text": "HEIC → PNG", "callback_data": "again_heic_png"}]
        ])
    
    buttons.append([{"text": "Назад", "callback_data": "back"}])
    return {"inline_keyboard": buttons}

