def download_file(file_id, filename):
    file_info = make_request(f"getFile?file_id={file_id}")
    if file_info.get("ok"):
        file_path = file_info["result"]["file_path"]
        file_url = f"https://api.telegram.org/file/bot{TOKEN}/{file_path}"
        urllib.request.urlretrieve(file_url, filename)
        return True
    return False

def convert_txt_to_pdf_fpdf(input_path, output_path):
    try:
        from fpdf import FPDF
        pdf = FPDF()
        pdf.add_page()
        pdf.add_font('DejaVu', '', 'DejaVuSans.ttf', uni=True)
        pdf.set_font('DejaVu', '', 12)
        
        with open(input_path, 'r', encoding='utf-8') as f:
            lines = f.readlines()
        
        for line in lines:
            pdf.cell(200, 10, txt=line.strip(), ln=1)
        
        pdf.output(output_path)
        return True
    except:
        try:
            with open(input_path, 'r', encoding='utf-8') as f:
                content = f.read()
            with open(output_path, 'w', encoding='utf-8') as f:
                f.write(f"PDF версия:\n\n{content}")
            return True
        except:
            return False

def convert_image_pil(input_path, output_path, target_format):
    try:
        with Image.open(input_path) as img:
            if img.mode in ('RGBA', 'LA') and target_format == 'JPEG':
                background = Image.new('RGB', img.size, (255, 255, 255))
                if img.mode == 'RGBA':
                    background.paste(img, mask=img.split()[3])
                else:
                    background.paste(img, mask=img.split()[1])
                img = background
            
            img.save(output_path, target_format)
            return True
    except:
        return False

def convert_heic_to_image(input_path, output_path, target_format):
    try:
        if not PYHEIF_AVAILABLE:
            return False
        
        with Image.open(input_path) as img:
            if img.mode in ('RGBA', 'LA') and target_format == 'JPEG':
                background = Image.new('RGB', img.size, (255, 255, 255))
                if img.mode == 'RGBA':
                    background.paste(img, mask=img.split()[3])
                else:
                    background.paste(img, mask=img.split()[1])
                img = background
            
            img.save(output_path, target_format)
            return True
    except:
        return False

def convert_docx_to_txt_python_docx(input_path, output_path):
    try:
        from docx import Document
        doc = Document(input_path)
        text = '\n'.join([paragraph.text for paragraph in doc.paragraphs])
        with open(output_path, 'w', encoding='utf-8') as f:
            f.write(text)
        return True
    except:
        return False

def convert_pdf_to_docx(input_path, output_path):
    try:
        if not PYTESSERACT_AVAILABLE:
            return False
        
        images = convert_from_path(input_path)
        
        if not images:
            return False
        
        from docx import Document
        from docx.shared import Inches
        
        doc = Document()
        
        for i, image in enumerate(images):
            temp_img = os.path.join(os.path.dirname(output_path), f"temp_page_{i}.jpg")
            image.save(temp_img, 'JPEG')
            
            try:
                text = pytesseract.image_to_string(temp_img, lang='rus+eng')
                if text.strip():
                    doc.add_paragraph(text)
            except:
                pass
            
            doc.add_picture(temp_img, width=Inches(6))
            os.unlink(temp_img)
        
        doc.save(output_path)
        return True
        
    except:
        return False

