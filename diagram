def download_file(file_id, filename):
    try:
        file_info = make_request(f"getFile?file_id={file_id}")
        if file_info.get("ok"):
            file_path = file_info["result"]["file_path"]
            file_url = f"https://api.telegram.org/file/bot{TOKEN}/{file_path}"
            urllib.request.urlretrieve(file_url, filename)
            print(f"Файл скачан: {filename}, размер: {os.path.getsize(filename)} байт")
            return True
    except Exception as e:
        print(f"Ошибка скачивания: {e}")
    return False

def convert_txt_to_pdf(input_path, output_path):
    try:
        from fpdf import FPDF
        pdf = FPDF()
        pdf.add_page()
        pdf.set_font("Arial", size=12)
        
        with open(input_path, 'r', encoding='utf-8') as f:
            for line in f:
                line = line.strip()
                if line:
                    pdf.cell(200, 10, txt=line, ln=1)
        
        pdf.output(output_path)
        return True
    except Exception as e:
        print(f"Ошибка TXT->PDF: {e}")
        return False

def convert_image(input_path, output_path, target_format):
    try:
        with Image.open(input_path) as img:
            if img.mode in ('RGBA', 'LA') and target_format == 'JPEG':
                background = Image.new('RGB', img.size, (255, 255, 255))
                if img.mode == 'RGBA':
                    background.paste(img, mask=img.split()[3])
                else:
                    background.paste(img, mask=img.split()[1])
                img = background
            img.save(output_path, target_format)
        return True
    except Exception as e:
        print(f"Ошибка конвертации изображения: {e}")
        return False

def convert_docx_to_txt(input_path, output_path):
    try:
        from docx import Document
        doc = Document(input_path)
        text = []
        for paragraph in doc.paragraphs:
            if paragraph.text:
                text.append(paragraph.text)
        
        with open(output_path, 'w', encoding='utf-8') as f:
            f.write('\n'.join(text))
        return True
    except Exception as e:
        print(f"Ошибка DOCX->TXT: {e}")
        return False

def convert_pdf_to_docx(input_path, output_path):
    """Конвертация PDF в DOCX"""
    print("=" * 50)
    print("НАЧАЛО КОНВЕРТАЦИИ PDF → DOCX")
    print("=" * 50)
    
    try:
        # Проверяем входной файл
        if not os.path.exists(input_path):
            print(f"❌ Входной файл не существует: {input_path}")
            return False
        
        file_size = os.path.getsize(input_path)
        print(f"📄 Размер PDF: {file_size} байт")
        
        if file_size == 0:
            print("❌ Файл пустой")
            return False
        
        # Импортируем библиотеки
        import PyPDF2
        from docx import Document
        print("✅ Библиотеки импортированы")
        
        # Читаем PDF
        print("📖 Читаем PDF...")
        text = ""
        with open(input_path, 'rb') as file:
            reader = PyPDF2.PdfReader(file)
            pages = len(reader.pages)
            print(f"📑 Всего страниц: {pages}")
            
            for i in range(pages):
                page = reader.pages[i]
                page_text = page.extract_text()
                if page_text:
                    text += page_text + "\n\n"
                    print(f"   Страница {i+1}: {len(page_text)} символов")
                else:
                    print(f"   Страница {i+1}: нет текста")
        
        if not text.strip():
            print("❌ Не удалось извлечь текст из PDF")
            return False
        
        print(f"✅ Извлечено текста: {len(text)} символов")
        
        # Создаем DOCX
        print("📝 Создаем DOCX...")
        doc = Document()
        doc.add_heading('Извлеченный текст из PDF', 0)
        
        # Добавляем текст по абзацам
        for line in text.split('\n'):
            if line.strip():
                doc.add_paragraph(line.strip())
        
        doc.save(output_path)
        print(f"✅ DOCX создан: {output_path}")
        
        # Проверяем результат
        if os.path.exists(output_path):
            out_size = os.path.getsize(output_path)
            print(f"📊 Размер DOCX: {out_size} байт")
            return out_size > 0
        else:
            print("❌ DOCX файл не создан")
            return False
            
    except Exception as e:
        print(f"❌ Ошибка: {e}")
        import traceback
        traceback.print_exc()
        return False

def convert_pdf_to_txt(input_path, output_path):
    try:
        import PyPDF2
        text = ""
        with open(input_path, 'rb') as file:
            reader = PyPDF2.PdfReader(file)
            for page in reader.pages:
                text += page.extract_text() + "\n"
        
        with open(output_path, 'w', encoding='utf-8') as f:
            f.write(text)
        return True
    except Exception as e:
        print(f"Ошибка PDF->TXT: {e}")
        return False

